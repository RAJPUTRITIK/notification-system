SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*
# Comma separated frontend origins (Vercel URL in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Leave empty to use SQLite locally. On Render use the Postgres URL.
DATABASE_URL=

# Admin user create
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_EMAIL=admin@example.com

# WhatsApp Cloud API (sandbox)
WHATSAPP_ACCESS_TOKEN=your_test_token
PHONE_NUMBER_ID=your_test_phone_number_id
# Optional: only needed if you want to submit/sync real templates with Meta
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Email: postmark | brevo | resend
EMAIL_PROVIDER=postmark
POSTMARKAPP_TOKEN=your_server_token
POSTMARK_FROM_EMAIL=your_verified_email@example.com
BREVO_API_KEY=
BREVO_FROM_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Web Push (OneSignal)
ONESIGNAL_APP_ID=your_app_id
ONESIGNAL_REST_API_KEY=your_api_key

# Logging: DEBUG | INFO | WARNING | ERROR. File logs go to backend/logs/ (ignored by git)
LOG_LEVEL=INFO
LOG_TO_FILE=True